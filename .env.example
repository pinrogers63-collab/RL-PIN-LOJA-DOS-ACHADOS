# RL PIN - variáveis externas. Não commitar valores reais.

# Supabase (o app possui fallback público seguro; estas variáveis podem sobrescrever)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Automação Vercel
CRON_SECRET=

# URL pública principal
NEXT_PUBLIC_APP_URL=https://rl-pin-loja-dos-achados-omini1.vercel.app

# Mercado Livre
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
# Opcional: se vazio, o app monta automaticamente usando NEXT_PUBLIC_APP_URL
MERCADOLIVRE_REDIRECT_URI=

# Shopee
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=

# TikTok Shop
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_ACCESS_TOKEN=

# Pinterest
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_ACCESS_TOKEN=

# Salão / Vitória - provedores reais
IMAGE_PROVIDER_API_KEY=
VIDEO_PROVIDER_API_KEY=
VOICE_PROVIDER_API_KEY=

# Amazon SP-API (futuro conector)
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=

# Novos conectores
# Adicione as credenciais do provedor e registre-o em lib/integration-registry.ts.
